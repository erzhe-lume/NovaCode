  "cards": [
    {
      "dot": "cyan",
      "title": "ReAct 循环",
      "items": [
        "迭代开始：interrupt 检查 + hook:turn_start 注入 + schema 重算 + ctx 两层压缩",
        "LLM 流式：computeSchemas(plan/whitelist/filter) → prepareBeforeRequest → streamOnce",
        "结果回注：tool 结果写入 history，下一轮 LLM 基于完整上下文继续推理"
      ]
    },
    {
      "dot": "rose",
      "title": "四重停止条件",
      "items": [
        "自然结束：模型无工具调用 → 记忆沉淀 + session sync",
        "迭代上限：50 轮自动停止（可继续发消息推进）",
        "连续未知工具：3 轮只请求未注册工具 → 自动停止",
        "流超时 / 用户取消：90s 超时或 Ctrl+C 中断"
      ]
    },
    {
      "dot": "amber",
      "title": "批量执行策略",
      "items": [
        "READ 类工具（ReadFile/Glob/Grep）：虚拟线程并发批次执行",
        "WRITE/COMMAND 类工具（WriteFile/EditFile/Bash）：串行逐个执行",
        "权限拒绝和 Hook 拦截的结果直接回注模型，不阻塞批次"
      ]
    }
  ]
}
